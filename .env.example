# Backend — copy to backend/.env (never commit)
DATABASE_URL=sqlite:///./technexus.db
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ENVIRONMENT=development
DEBUG=false
SESSION_COOKIE=tnx_session
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
RATE_LIMIT_PER_MINUTE=12
TRUSTED_HOSTS=*
EVENT_DATE=2026-12-12
EVENT_START_TIME=11:00

# Production example (PostgreSQL + HTTPS):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/technexus
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-event.example.com
# TRUSTED_HOSTS=your-event.example.com
